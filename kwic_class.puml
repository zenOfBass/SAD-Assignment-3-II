@startuml kwic
package "KWIC System" {

    class KWICDataStore {
        -List~Line~ originalLines
        -List~Line~ circularShifts
        -List~Line~ filteredShifts
        -List~String~ noiseWords
        +addLine(Line line)
        +getLines() List~Line~
        +addCircularShift(Line shift)
        +getCircularShifts() List~Line~
        +addFilteredShift(Line shift)
        +getFilteredShifts() List~Line~
        +isNoiseWord(String word) boolean
    }

    class Master {
        -KWICDataStore dataStore
        +run()
        +getResults() List~Line~
    }

    class LineProcessor {
        -KWICDataStore dataStore
        +processInput(String input)
    }

    class ShiftGenerator {
        -KWICDataStore dataStore
        +generateShifts()
    }

    class NoiseFilter {
        -KWICDataStore dataStore
        +filterNoiseWords()
    }

    class LineSorter {
        -KWICDataStore dataStore
        +sortLines()
    }

    class Line {
        -List~String~ words
        +Line(List~String~ words)
        +Line(String line)
        +getWords() List~String~
        +generateCircularShifts() List~Line~
        +toString() String
        +compareTo(Line other) int
        +getFirstWord() String
    }

    KWICDataStore --> Line
    Master --> KWICDataStore
    Master --> LineProcessor
    Master --> ShiftGenerator
    Master --> NoiseFilter
    Master --> LineSorter
    WebController --> Master
    LineProcessor --> KWICDataStore
    ShiftGenerator --> KWICDataStore
    NoiseFilter --> KWICDataStore
    LineSorter --> KWICDataStore
}
@enduml
