@startuml kwic
package "KWIC System" {

    class Master {
        +void execute()
        -void sequenceModules()
    }

    class LineStorage {
        -dataRepresentation
        +void setChar(int line, int word, int charPos, char character)
        +char getChar(int line, int word, int charPos)
        +int wordCount(int line)
        +int lineCount()
        +void initialize()
    }

    class Input {
        -LineStorage storage
        +void read(String source)
        -void processLine(String line)
        +void setLineStorage(LineStorage storage)
    }

    class CircularShift {
        -shiftRepresentation
        +void setup()
        +char getChar(int shift, int word, int charPos)
        +void setChar(int shift, int word, int charPos, char character)
        +int wordCount(int shift)
        +int shiftCount()
        +void setLineStorage(LineStorage storage)
    }

    class Alphabetizer {
        -indexRepresentation
        +void alphabetize()
        +int getShiftIndex(int position)
        +int count()
        +void setCircularShift(CircularShift shifter)
    }

    class Output {
        +void writeOutput(String destination)
        -void formatLine(int lineIndex)
        +void setAlphabetizer(Alphabetizer alphabetizer)
        +void setCircularShift(CircularShift shifter)
    }

    Master --> Input
    Master --> LineStorage
    Master --> CircularShift
    Master --> Alphabetizer
    Master --> Output
    Master --> Alphabetizer
    
    Input --> LineStorage
    CircularShift --> LineStorage
    Alphabetizer --> CircularShift
    Output --> Alphabetizer
    Output --> CircularShift
}
@enduml
